{
  "name": "visionqc-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "mongo:dev": "node scripts/mongo-dev.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "test:e2e": "node --env-file-if-exists=.env scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "mongoose": "^8.0.0",
    "multer": "^2.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "mongodb-memory-server-core": "^11.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
